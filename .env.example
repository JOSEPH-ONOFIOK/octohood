# Production storage: a Google Sheet via the Apps Script in google-apps-script/Code.gs
# (setup steps are at the top of that file). Leave empty to use .data/allowlist.json locally.
# SHEET_SCRIPT_URL is the web app URL ending in /exec. Keep it private: anyone with it can
# add rows to the sheet.
SHEET_SCRIPT_URL=

# Secret for downloading the allowlist CSV: /api/allowlist/export?key=...
ADMIN_KEY=

# The pinned post people like, repost, quote and reply to: paste its link from X
# (https://x.com/octohood/status/123…) or just the digits after /status/.
# Changing it needs a redeploy on Vercel (Deployments → Redeploy).
NEXT_PUBLIC_PINNED_POST=

# Sign in with X (OAuth 2.0). In the X developer portal, turn on OAuth 2.0 for the app
# (type: Web App), and add <your site>/api/x/callback (and http://localhost:3000/api/x/callback
# for dev) as callback URLs.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Signs the X session cookie. Any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# The site's public URL, for link previews. On Vercel the production domain is used if unset.
NEXT_PUBLIC_SITE_URL=
